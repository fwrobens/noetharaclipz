# Public configuration for the EXISTING project only.
VITE_SUPABASE_URL=https://zxdnjnsghdnviflahvry.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_wlXMNmobAj-bq_wKU7BduQ_FoKG6Eyk
# Worker only. Never prefix these with VITE_.
SUPABASE_URL=https://zxdnjnsghdnviflahvry.supabase.co
# Preferred: modern server secret; the legacy-named alias below also accepts modern keys.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Select explicitly; there is no automatic provider fallback.
NC_AI_PROVIDER=local
# Development tests MUST set this to their own temporary QA user UUID.
# An empty scope permits the global queue and must not be used around protected jobs.
NC_WORKER_OWNER_ID=
# Worker-private cache of decoded media, ASR, and local inference, pruned at 24h/1GiB.
NC_WORKER_CACHE_DIR=worker/.cache/pipeline
GEMINI_API_KEY=
# Set only after checking billing tier and actual project quotas in AI Studio.
GEMINI_FREE_TIER_VERIFIED=false
GEMINI_VERIFIED_RPM=0
GEMINI_VERIFIED_RPD=0
GEMINI_VERIFIED_TPM=0
WHISPER_MODEL=small
# Optional AI refinement router (worker only; disabled by default => zero external requests).
# Real NVIDIA/AnyModel calls need separate approval; free NVIDIA endpoints are trial/evaluation only.
# Keys may also be provided as files via NVIDIA_API_KEY_FILE / ANYMODEL_API_KEY_FILE.
NC_ROUTER_ENABLED=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
ANYMODEL_API_KEY=
ANYMODEL_BASE_URL=
NC_REASONING_MODEL=
NC_VISION_CONTEXT_MODEL=
NC_FALLBACK_MODEL=
NC_ANYMODEL_FALLBACK_MODEL=
NC_ROUTER_TIMEOUT_SECONDS=
