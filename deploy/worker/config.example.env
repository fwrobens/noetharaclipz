# No credential values here. Keep the actual key in a root-owned file readable
# only by the dedicated worker group (gid 62001), mode 0440.
NC_SUPABASE_KEY_FILE=/etc/noetharaclipz-isolated/supabase-key
NC_WORKER_ROOT=/var/lib/noetharaclipz-isolated
NC_WORKER_IMAGE=noetharaclipz-worker:review
NC_DEPLOY_MODE=standby
NC_WORKER_OWNER_ID=
